{
  "git-guard": {
    "PreToolUse": [
      {
        "matcher": "run_command",
        "hooks": [
          {
            "type": "command",
            "command": "./scripts/git-guard.py",
            "timeout": 5
          }
        ]
      }
    ]
  },
  "polyglot-linter": {
    "PostToolUse": [
      {
        "matcher": "edit_file|write_file",
        "hooks": [
          {
            "type": "command",
            "command": "./scripts/polyglot-lint.py",
            "timeout": 20
          }
        ]
      }
    ]
  }
}

