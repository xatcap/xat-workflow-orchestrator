{
  "Urls": "http://127.0.0.1:8430",
  "AllowedHosts": "localhost;127.0.0.1;[::1]",
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Api": {
    "DefaultPipeline": "rag-qa",
    "MaxConcurrentRuns": 8,
    "QueueLimit": 16
  },
  "Runs": {
    "RunTimeout": "00:05:00"
  },
  "Jobs": {
    "Workers": 2,
    "WebhookWorkers": 4,
    "QueueLimit": 64,
    "RetainFinished": 500,
    "RetentionMinutes": 60
  },
  "Webhooks": {
    "AllowedHosts": [],
    "TimeoutSeconds": 10,
    "RetryCount": 3,
    "RetryDelayMilliseconds": 1000
  },
  "Ingestion": {
    "Enabled": true,
    "DisabledRoutes": [],
    "MaxUploadBytes": 67108864,
    "ActivityTimeoutSeconds": 120
  },
  "Upstreams": {
    "XatRag": {
      "ReadyFile": "",
      "BaseUrl": "http://127.0.0.1:8421",
      "RequestTimeoutSeconds": 30,
      "RetryCount": 2
    },
    "XatLlmEngine": {
      "BaseUrl": "http://127.0.0.1:8420",
      "RequestTimeoutSeconds": 180,
      "RetryCount": 2
    }
  },
  "Retrieval": {
    "Profiles": {
      "default": { "Context": "ask-all", "Chunks": 8 },
      "docs": { "Context": "ask-docs", "Chunks": 5 },
      "jira": { "Context": "ask-jira", "Chunks": 5 },
      "diffs": { "Context": "ask-diffs", "Chunks": 5 }
    }
  },
  "Llm": {
    "DefaultModel": "default",
    "Models": {
      "default": {
        "Model": "local/ministral-3-3b",
        "Parallel": 1,
        "AllowedFields": [ "temperature", "max_tokens", "stream_options" ]
      }
    }
  },
  "Pipelines": {
    "Folder": "pipelines"
  },
  "Prompts": {
    "Folder": "prompts"
  }
}
